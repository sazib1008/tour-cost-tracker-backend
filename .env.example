# ==========================================
# Tripzy Backend Environment Variables Template
# Copy this file to .env and fill in the values
# ==========================================

# Server Port
PORT=8080

# MongoDB Configuration (Atlas or Local)
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tripzy_db?retryWrites=true&w=majority

# JWT Configuration (Must be at least 256 bits / 32 characters long for HMAC-SHA256)
JWT_SECRET=your-secure-jwt-secret-key-that-must-be-at-least-256-bits-long
JWT_EXPIRATION_MS=2592000000

# Google OAuth2 Client ID & Secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Logging (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=DEBUG
